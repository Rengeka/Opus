<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="IdentifierParser.fs" />
    <Compile Include="ModuleParser.fs" />
    <Compile Include="DirectiveParser.fs" />
    <Compile Include="LiteralParser.fs" />
    <Compile Include="InstructionParser.fs" />
    <Compile Include="OpusParser.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FParsec" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Opus.Grammar\Opus.Grammar.csproj" />
    <ProjectReference Include="..\Opus.Kernel\Opus.Kernel.csproj" />
  </ItemGroup>

</Project>
